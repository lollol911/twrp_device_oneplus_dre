# Copied verbatim from /system/etc/init/init.qcom.recovery.rc in the existing
# vendor_boot ramdisk. TWRP's init.rc imports /init.recovery.${ro.hardware}.rc
# (ro.hardware = qcom here). This file is what:
#   - sets sys.usb.configfs=1, which TWRP's init.rc needs for adb over configfs
#   - puts the UDC in peripheral mode
#   - creates /dev/block/bootdevice, which recovery.fstab relies on

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

# ---------------------------------------------------------------------------
# MTP over configfs/FunctionFS (added for TWRP).
# TWRP's own init.rc only creates ffs.adb and ffs.fastboot, and its MTP server opens
# /dev/usb-ffs/mtp/ep0 (or /dev/mtp_usb on legacy kernels). Neither existed on this phone,
# hence "could not open MTP driver, errno: 2". This is the AOSP-style gadget layout:
#   mtp function = f1, adb function = f2, bound only after both write their descriptors.
# TWRP sets sys.usb.config=none first, then mtp,adb; the server sets sys.usb.ffs.mtp.ready=1.
# ---------------------------------------------------------------------------

on property:sys.usb.config=mtp,adb && property:sys.usb.configfs=1
    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 system system
    mount functionfs mtp /dev/usb-ffs/mtp rmode=0770,fmode=0660,uid=1000,gid=1000
    start adbd

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.ffs.mtp.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idProduct 0x4EE2
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

# TWRP's init.rc already unbinds the UDC and removes f1 on "none"; also drop f2 and reset the mtp flag.
on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2
    setprop sys.usb.ffs.mtp.ready 0
